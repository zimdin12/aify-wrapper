{
  "specVersion": 1,
  "name": "aify-dashboard",
  "version": "1.3.14",
  "fixed": {
    "agentState": {
      "path": "/api/v1/agent-state"
    },
    "sessionInject": {
      "mcp": true
    },
    "advertise": false,
    "turnStart": {
      "path": "/events/turn-start",
      "budgetMs": 800
    }
  },
  "artifacts": [
    {
      "id": "dashboard-bridge",
      "kind": "package",
      "source": {
        "git": {
          "repo": "zimdin12/aify-dashboard",
          "revision": "2d9121dbae592540a8cf8955a4570e16634310d8"
        }
      },
      "entries": [
        "aify-dashboard-bridge"
      ]
    }
  ],
  "mcp": [
    {
      "name": "aify-dashboard",
      "artifact": "dashboard-bridge",
      "entry": "aify-dashboard-bridge"
    }
  ],
  "secrets": [
    {
      "field": "credentialRef",
      "required": true,
      "probe": "api"
    },
    {
      "field": "secretsCredentialRef",
      "required": false
    }
  ],
  "verify": {
    "health": {
      "path": "/health"
    },
    "probes": {
      "api": {
        "path": "/api/v1/settings/schema",
        "header": "x-api-key"
      }
    }
  }
}
