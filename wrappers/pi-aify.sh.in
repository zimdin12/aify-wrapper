#!/bin/bash
#| pi-aify / omp-aify -- the wrapper aify-comms would install for Pi/OMP.
#|
#| A TEMPLATE. At render time `@@TOKEN@@` placeholders are substituted and every `#|` line is REMOVED.
#| See wrappers/claude-aify.sh.in for why these bodies are files rather than heredocs.
#|
#| INSTALLING this wrapper is deliberately disabled -- OMP is single-client, so omp-aify cannot provide
#| resident wake into an open TUI, and managed Pi runs through the environment bridge instead. RENDERING
#| it is a different act and stays possible, which is what lets it be tested and kept honest.
#|
#| Placeholders, written split so they are inert here:
#|   @@ + ENDPOINT@@   coordinating service URL with the built-in fallback applied
set -euo pipefail

# ── The harness wrapper contract ────────────────────────────────────────────
#
# Same six inputs, same precedence, same reasons as claude-aify and codex-aify — see
# docs/superpowers/specs/2026-08-19-harness-wrapper-contract.md. Every input falls back to its legacy
# AIFY_* name, so with nothing set this resolves to what the wrapper used before the contract existed.
#
# HARNESS_MCP_COMMAND is accepted and reported as unused, as in codex: this launcher writes no MCP
# config. Pi is also the runtime whose RESIDENT wrapper is deliberately not installed — OMP is
# single-client, so it cannot provide resident wake — which makes --check the only way most people will
# ever exercise this file. That is a reason to have it, not a reason to skip it.
HARNESS_WRAPPER_RUNTIME="pi"
HARNESS_WRAPPER_VERSION="@@WRAPPER_VERSION@@"
#| Baked at install, never read at launch: parsing the registry on every start would spend the
#| MCP discovery budget hermes gives us, and a launcher cannot learn about a service that was
#| registered after it was written anyway. This is how a holder of the CURRENT registry can
#| tell that it could not - by READING the launcher, without starting the runtime.
HARNESS_REGISTRY_FINGERPRINT="@@REGISTRY_FINGERPRINT@@"
#| Exported so the runtime -- and through it the bridge and the service -- can learn which
#| launcher started this session and which registry it was built against. Kept as shell locals
#| these were readable only by opening the file on the host, which is the whole reason a
#| host-side staleness check existed. The export references the assignment above rather than
#| repeating the placeholder: two sources for one fact is how they drift.
export HARNESS_WRAPPER_VERSION="$HARNESS_WRAPPER_VERSION"
export HARNESS_REGISTRY_FINGERPRINT="$HARNESS_REGISTRY_FINGERPRINT"
HARNESS_ENDPOINT="${HARNESS_ENDPOINT-${AIFY_COMMS_URL:-@@ENDPOINT@@}}"
HARNESS_IDENTITY="${HARNESS_IDENTITY:-${AIFY_AGENT_ID:-}}"
HARNESS_ROLE="${HARNESS_ROLE:-${AIFY_AGENT_ROLE:-}}"
HARNESS_CWD="${HARNESS_CWD:-${AIFY_AGENT_CWD:-}}"
HARNESS_MCP_COMMAND="${HARNESS_MCP_COMMAND:-}"
HARNESS_EXTRA_ENV="${HARNESS_EXTRA_ENV:-}"
HARNESS_EXIT_CONFIG=78
HARNESS_EXIT_NO_RUNTIME=127

if [ -n "$HARNESS_EXTRA_ENV" ]; then
  while IFS= read -r _pair; do
    case "$_pair" in
      ""|"#"*) continue ;;
      *=*) export "${_pair%%=*}=${_pair#*=}" ;;
    esac
  done <<HARNESS_ENV_EOF
$HARNESS_EXTRA_ENV
HARNESS_ENV_EOF
fi

# `-` not `:-` above: an explicitly emptied endpoint is a configuration error, not an unset one.
if [ -z "$HARNESS_ENDPOINT" ]; then
  echo "[pi-aify] HARNESS_ENDPOINT is empty. A wrapper will not guess an endpoint." >&2
  exit "$HARNESS_EXIT_CONFIG"
fi

PI_AIFY_AGENT_ID="$HARNESS_IDENTITY"
PI_AIFY_ROLE="${HARNESS_ROLE:-coder}"
PI_AIFY_SESSION_MODE="${AIFY_SESSION_MODE:-}"
PI_SESSION_HANDLE="${PI_SESSION_ID:-${OMP_SESSION_ID:-${AIFY_PI_SESSION_ID:-}}}"
PI_RUNTIME_COMMAND="${AIFY_PI_COMMAND:-${PI_COMMAND:-omp}}"
PI_AIFY_STANDALONE=false
HARNESS_CHECK=false
# Bypass approval prompts by DEFAULT (2026-06-02 — every *-aify bypasses so
# unattended agents never stall). omp's native flag is --auto-approve. Opt out
# per-launch with --safe / --no-auto.
PI_AUTO=true
PI_ARGS=()
# --shared: let the HOST TIER own this session's terminal, so closing this window does not end it.
# Recognised here, acted on at the very bottom; every path in between is unchanged, which is the
# operator's constraint on this feature -- an ordinary run must be exactly what it was.
PI_AIFY_SHARED=false
# THE ORIGINAL ARGUMENTS, CAPTURED ONCE, minus the flag. Rebuilt inside the parse loop instead, it
# would have to be appended in every one of that loop's branches -- and the branch somebody adds next
# year is the one that silently drops an argument from the relaunch. Filtering `"$@"` here cannot
# drift with the loop, because it does not read it.
PI_AIFY_PASSTHRU=()
for _ORIGINAL in "$@"; do
  [ "$_ORIGINAL" = "--shared" ] || PI_AIFY_PASSTHRU+=("$_ORIGINAL")
done

PREV_ARG=""
for ARG in "$@"; do
  # EXACTLY THIS WORD. `--shared-anything` belongs to whoever reads it; a prefix test here would
  # swallow it and host a session nobody asked to host. Consumed so it never reaches the runtime.
  if [ "$ARG" = "--shared" ]; then
    PI_AIFY_SHARED=true
    continue
  fi
  if [ "$PREV_ARG" = "--aify-agent" ] || [ "$PREV_ARG" = "--agent-id" ]; then
    PI_AIFY_AGENT_ID="$ARG"
    PREV_ARG=""
    continue
  fi
  if [ "$PREV_ARG" = "--aify-role" ]; then
    PI_AIFY_ROLE="$ARG"
    PREV_ARG=""
    continue
  fi
  if [ "$ARG" = "--resident" ]; then
    PI_AIFY_SESSION_MODE="resident"
    continue
  fi
  if [ "$ARG" = "--managed" ]; then
    PI_AIFY_SESSION_MODE="managed"
    continue
  fi
  if [ "$ARG" = "--standalone" ]; then
    # Operator override of the Phase 4 watchdog. Lets you launch a parallel
    # OMP session on a different session-id while the bridge keeps driving
    # the dashboard one. Pass --resume <other-id> alongside if you actually
    # want to attach to a saved session.
    PI_AIFY_STANDALONE=true
    continue
  fi
  if [ "$ARG" = "-auto" ] || [ "$ARG" = "--auto" ] || [ "$ARG" = "--yolo" ]; then
    PI_AUTO=true
    continue
  fi
  if [ "$ARG" = "--safe" ] || [ "$ARG" = "--no-auto" ]; then
    PI_AUTO=false
    continue
  fi
  # Consumed here, never forwarded.
  if [ "$ARG" = "--check" ]; then
    HARNESS_CHECK=true
    continue
  fi
  if [ "$ARG" = "--aify-agent" ] || [ "$ARG" = "--agent-id" ] || [ "$ARG" = "--aify-role" ]; then
    PREV_ARG="$ARG"
    continue
  fi
  case "$ARG" in
  --aify-agent=*|--agent-id=*)
    PI_AIFY_AGENT_ID="${ARG#*=}"
    continue
    ;;
  --aify-role=*)
    PI_AIFY_ROLE="${ARG#*=}"
    continue
    ;;
  --resume=*|--session-id=*)
    PI_SESSION_HANDLE="${ARG#*=}"
    ;;
  -r=*)
    PI_SESSION_HANDLE="${ARG#*=}"
    ;;
  esac
  PI_ARGS+=("$ARG")
  if [ "$PREV_ARG" = "--resume" ] || [ "$PREV_ARG" = "--session-id" ] || [ "$PREV_ARG" = "-r" ]; then
    PI_SESSION_HANDLE="$ARG"
  fi
  PREV_ARG="$ARG"
done

export AIFY_RUNTIME="pi"
if [ -n "$PI_AIFY_AGENT_ID" ]; then
  export AIFY_AGENT_ID="$PI_AIFY_AGENT_ID"
  export AIFY_AGENT_ROLE="$PI_AIFY_ROLE"
fi
if [ -n "$PI_SESSION_HANDLE" ]; then
  export PI_SESSION_ID="$PI_SESSION_HANDLE"
  export AIFY_SESSION_HANDLE="$PI_SESSION_HANDLE"
fi
# Symmetric env-var for future pi turn hooks (omp does not currently expose user-prompt-submit/stop
# hook surfaces, but exposing the service URL means a future omp hook surface — or operator-written
# tooling that wraps pi-aify — can call /turn-start /turn-end without additional setup).
export AIFY_COMMS_URL="$HARNESS_ENDPOINT"

# Session-mode resolution: explicit flag/env > TTY auto-detect.
# Same contract as claude-aify; works on Ubuntu bash and Git Bash for
# Windows (POSIX [-t 0] test). Bridge-spawned wrappers always have
# AIFY_SESSION_MODE set explicitly via terminalChildEnv.
# INFERRED, NOT CHOSEN -- and that distinction has to survive a `--shared` relaunch (R9-M10,
# external review 2026-09-06). This resolves from THIS process's stdin, and the `--shared` block
# below hands the session to aify-env, which forwards the whole environment to a host that runs the
# launcher IN A PTY. So a non-TTY caller -- a script, a CI job, a non-interactive shell -- inferred
# `managed` here and pinned it onto a relaunch where `[ -t 0 ]` would have said `resident`. The
# service then treats a session with a real PTY as a backing process with no operator at it.
#
# An EXPLICIT choice (--resident, --managed, or AIFY_SESSION_MODE in the environment) must still
# travel, which is why this marks the inference rather than dropping the value outright.
AIFY_SESSION_MODE_INFERRED=0
if [ -z "$PI_AIFY_SESSION_MODE" ]; then
  if [ -t 0 ]; then
    PI_AIFY_SESSION_MODE="resident"
  else
    PI_AIFY_SESSION_MODE="managed"
  fi
  AIFY_SESSION_MODE_INFERRED=1
fi
export AIFY_SESSION_MODE="$PI_AIFY_SESSION_MODE"

# Phase 4 watchdog: refuse to launch OMP if the aify-comms bridge is already
# driving this agent's pi session through its persistent RPC child. The
# upstream RPC channel has no multiplexing — two processes on the same
# session-id step on each other. Soft mutex: this is a single HTTP read
# that fails open (timeout / network error / non-pi runtime → exec normally).
# Override with --standalone if you intentionally want a parallel session
# on a different session-id (pass --resume <other-id> too).
#
# Plan 6 follow-up (2026-05-26): when the dashboard's TerminalProcessManager
# spawns this wrapper as the managed backing (AIFY_MANAGED_VIA_WRAPPER=1),
# the bridgeOwned=true response is the DASHBOARD itself. Skipping the
# watchdog in that case lets the wrapper-managed PTY actually start —
# without this, the dashboard-spawned pi-aify exits within ~1s and the
# operator sees a Console widget that never attaches. (Observed
# 2026-05-26 with graph-tester-pi: 4 spawn attempts in 3 minutes, each
# stopped after 1s.) Rediscover still runs so the bridge's stored session
# id stays truthful.
if [ "${AIFY_MANAGED_VIA_WRAPPER:-}" = "1" ]; then
  PI_AIFY_SKIP_BRIDGE_GUARD=true
else
  PI_AIFY_SKIP_BRIDGE_GUARD=false
fi
# NOT UNDER `--check`, WHICH MUST TOUCH NOTHING AND ALWAYS REPORT. This block calls the service and,
# when the agent is bridge-owned, exits 1 with "stop it from the dashboard" -- both of them BEFORE the
# report below is printed. So `pi-aify --check` made a network request on a command whose whole
# contract is that it starts nothing, and on a live managed agent it exited non-zero having printed no
# report at all: the operator asked "is this wrapper configured" and was told to stop an agent.
#
# The other three launchers do not have this problem. hermes and codex answer `--check` inline in the
# argument loop, above every probe; claude's report sits at line 231 with its first request at 298.
# This one grew a session-state probe at 200 while its report stayed at 247, and nothing compared them.
if [ "${HARNESS_CHECK:-false}" != true ] \
  && [ "$PI_AIFY_STANDALONE" != true ] && [ -n "$PI_AIFY_AGENT_ID" ] && [ -n "${AIFY_COMMS_URL:-}" ]; then
  AIFY_WATCHDOG_URL="${AIFY_COMMS_URL%/}/api/v1/agents/${PI_AIFY_AGENT_ID}/pi-session-state"
  AIFY_WATCHDOG_HEADERS=()
  if [ -n "${AIFY_API_KEY:-}" ]; then
    AIFY_WATCHDOG_HEADERS+=("-H" "X-API-Key: ${AIFY_API_KEY}")
  fi
  AIFY_WATCHDOG_BODY="$(curl -sS --max-time 2 "${AIFY_WATCHDOG_HEADERS[@]}" "$AIFY_WATCHDOG_URL" 2>/dev/null || true)"
  # Plan 6 B3 (2026-05-26): the pi-session-state response carries the
  # runtime's authoritative sessionId (set by Plan 4). Reuse the body we
  # just captured for the bridgeOwned check — no second HTTP call needed.
  # Overwrites PI_SESSION_ID / AIFY_SESSION_HANDLE so the inner aify-comms
  # MCP bridge registers with the truthful id, not a stale value from the
  # operator's parent shell. Failures non-fatal: empty result leaves env
  # alone and the bridge heartbeat (Plan 6 A1) corrects drift within 60s.
  PI_REDISCOVERED_SESSION_ID=""
  if [ -n "$AIFY_WATCHDOG_BODY" ]; then
    # Plan 6 follow-up (2026-05-26): the pi-session-state body legitimately
    # omits the sessionId key when no PTY is live yet (e.g. fresh
    # dashboard-spawned managed wrapper) — grep returns 1, and `set -euo
    # pipefail` then kills the whole wrapper SILENTLY before exec'ing omp.
    # That's the "pi-aify exits in 2s with no output" bug operators observed
    # 2026-05-26 with graph-tester-pi. Disable pipefail JUST around this
    # capture so a missing sessionId is empty (the intended behavior).
    set +o pipefail
    PI_REDISCOVERED_SESSION_ID="$(printf '%s' "$AIFY_WATCHDOG_BODY" \
      | grep -oE '"sessionId"[[:space:]]*:[[:space:]]*"[^"]+"' \
      | head -1 \
      | sed -E 's/.*"sessionId"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/')"
    set -o pipefail
  fi
  if [ -n "$PI_REDISCOVERED_SESSION_ID" ]; then
    if [ "${PI_SESSION_ID:-}" != "$PI_REDISCOVERED_SESSION_ID" ]; then
      echo "[pi-aify] session id rediscovered: '${PI_SESSION_ID:-}' -> '$PI_REDISCOVERED_SESSION_ID' (from pi-session-state)" >&2
    fi
    export PI_SESSION_ID="$PI_REDISCOVERED_SESSION_ID"
    export AIFY_SESSION_HANDLE="$PI_REDISCOVERED_SESSION_ID"
    PI_SESSION_HANDLE="$PI_REDISCOVERED_SESSION_ID"
  fi
  if [ "$PI_AIFY_SKIP_BRIDGE_GUARD" != true ] && [ -n "$AIFY_WATCHDOG_BODY" ] && printf '%s' "$AIFY_WATCHDOG_BODY" | grep -q '"bridgeOwned":[[:space:]]*true'; then
    cat >&2 <<EOM
Agent '${PI_AIFY_AGENT_ID}' is currently driven by @@SERVICE_NAME@@ (visible in dashboard terminal). Stop it from the dashboard or use \`omp-aify --standalone --aify-agent ${PI_AIFY_AGENT_ID}\` to launch a parallel session on a different session-id.
EOM
    exit 1
  fi
fi

# The runtime CLI, resolved before anything is launched. `exec` at the bottom would otherwise fail with
# bash's own "command not found" after every export and probe had already run.
if ! command -v "$PI_RUNTIME_COMMAND" >/dev/null 2>&1; then
  echo "[pi-aify] runtime CLI '$PI_RUNTIME_COMMAND' was not found on PATH." >&2
  exit "$HARNESS_EXIT_NO_RUNTIME"
fi

if [ "${HARNESS_CHECK:-false}" = true ]; then
  echo "pi-aify $HARNESS_WRAPPER_VERSION"
  echo "  runtime   : $HARNESS_WRAPPER_RUNTIME ($(command -v "$PI_RUNTIME_COMMAND"))"
  echo "  endpoint  : $HARNESS_ENDPOINT"
  echo "  identity  : ${PI_AIFY_AGENT_ID:-<none — this session would be anonymous>}"
  echo "  role      : $PI_AIFY_ROLE"
  echo "  cwd       : ${HARNESS_CWD:-<inherited>}"
  echo "  mcp       : not used by this wrapper"
  echo "  registry  : $HARNESS_REGISTRY_FINGERPRINT"
  echo "OK — nothing was started."
  exit 0
fi

PI_PERMISSION_FLAGS=()
if [ "$PI_AUTO" = true ]; then
  # omp global flag: auto-approve all tool calls (skip approval prompts).
  PI_PERMISSION_FLAGS+=(--auto-approve)
fi
# --shared: HAND THE SESSION TO THE HOST TIER instead of running it as a child of this shell.
#
# It asks aify-env to run THIS WRAPPER again, without the flag, and attaches to it. So what runs is
# exactly what the launch below would have run -- every resolution and every flag composed above --
# rather than a command rebuilt from the parts somebody remembered. It passes the host's launcher
# allowlist by being a wrapper, which is what that allowlist is for.
#
# The process then belongs to aify-env: closing this window leaves it running, Ctrl-] detaches, and
# anyone can attach again. That is the whole point.
#
# BELOW EVERYTHING, so an ordinary run reaches the launch having executed not one instruction of
# this. The operator's constraint on the feature is that the default path is unchanged.
if [ "$PI_AIFY_SHARED" = true ]; then
  if ! command -v aify-env >/dev/null 2>&1; then
    # `${0##*/}` rather than a hardcoded name: this block is shared by all four wrappers, and a
    # message naming one launcher is how the copy in another starts lying about itself.
    echo "${0##*/}: --shared needs aify-env on PATH; it is the tier that would own the session." >&2
    echo "  Install it, or run without --shared to start in this terminal as usual." >&2
    exit 69
  fi
  # AN INFERRED SESSION MODE DOES NOT CROSS THIS BOUNDARY (R9-M10). It was resolved from THIS
  # process's stdin, and the host will run the launcher in a PTY where the answer differs. Dropping
  # it lets the relaunched wrapper infer from the terminal it actually gets; an explicit --resident,
  # --managed or AIFY_SESSION_MODE is left alone and still travels.
  [ "${AIFY_SESSION_MODE_INFERRED:-0}" = 1 ] && unset AIFY_SESSION_MODE
  exec aify-env run --service "@@SERVICE_NAME@@" --launcher "$0" --label "${PI_AIFY_AGENT_ID:-}" -- "${PI_AIFY_PASSTHRU[@]}"
fi

exec "$PI_RUNTIME_COMMAND" "${PI_PERMISSION_FLAGS[@]}" "${PI_ARGS[@]}"
