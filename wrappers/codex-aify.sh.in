#!/bin/bash
#| codex-aify -- the wrapper aify-comms installs for Codex.
#|
#| A TEMPLATE. At render time `@@TOKEN@@` placeholders are substituted and every `#|` line is REMOVED.
#| See wrappers/claude-aify.sh.in for why these bodies are files rather than heredocs.
#|
#| This one was already a QUOTED heredoc, so it carried no escaping -- its install-time URL was patched
#| in afterwards by `sed -i "s|__AIFY_INSTALL_TIME_URL__|$URL|"`. That worked until a URL contained the
#| `|` delimiter. The renderer uses bash parameter substitution, which has no delimiter to collide with.
#|
#| Placeholders, written split so they are inert here:
#|   @@ + ENDPOINT@@   coordinating service URL with the built-in fallback applied
set -euo pipefail

# THE BRIDGE DIRECTORY AS NATIVE NODE OPENS IT, converted ONCE, before anything hands it to node.
# `@@BRIDGE_DIR@@` is rendered MSYS-style on Windows (/c/Users/...). Bash reads that; native Windows
# node reads it only while Git Bash rewrites the argument on the way, and MSYS_NO_PATHCONV=1 -- which
# hermes' own tool shell exports -- switches that off. Node then looked for C:/c/Users/..., and the
# resume lookup failed in silence (aify-comms v0.7.1 review, W04). So every `node` call below takes
# this, and bash keeps the raw placeholder.
# THE UNCONVERTED PATH FIRST, and the substitution kept out of the assignment: under `set -e` a
# `cygpath` that fails inside `VAR="$(...)"` would end the launch before the agent ran.
AIFY_BRIDGE_DIR_FWD="@@BRIDGE_DIR@@"
# THE WRAPPER'S OWN INSTALL ROOT, where every bin/ and lib/ helper below is found: this package's own directory,
# which arrives with the launcher (a service's bridge is used only for that service's code). Converted with the bridge
# directory, by ONE cygpath for both, since each start costs 100-500 ms on a loaded Windows host. The wrapper FIRST:
# cygpath answers each path in order and stops at an empty one, so an empty bridge path (render.sh run directly) still
# leaves the wrapper converted, and the wrapper path is always absolute (render.sh refuses any other).
AIFY_WRAPPER_DIR_FWD="@@WRAPPER_DIR@@"
if command -v cygpath >/dev/null 2>&1; then
  _aify_converted="$(cygpath -m "@@WRAPPER_DIR@@" "@@BRIDGE_DIR@@" 2>/dev/null || true)"
  if [ -n "${_aify_converted%%$'\n'*}" ]; then AIFY_WRAPPER_DIR_FWD="${_aify_converted%%$'\n'*}"; fi
  case "$_aify_converted" in *$'\n'?*) AIFY_BRIDGE_DIR_FWD="${_aify_converted#*$'\n'}" ;; esac
fi

# ONE LIVE INSTANCE PER AGENT (bin/aify-lease.sh, lib/agent-lease.mjs). Sourced first so every exit path,
# traps included, can call the release; a wrapper directory without the helper gets no-op stubs.
AIFY_LEASE_SH="@@WRAPPER_DIR@@/bin/aify-lease.sh"
if [ -r "$AIFY_LEASE_SH" ]; then
  . "$AIFY_LEASE_SH"
else
  aify_lease_take_intent() { AIFY_LEASE_ARGS=("$@"); }
  aify_lease_claim() { return 0; }
  aify_lease_attach() { :; }
  aify_lease_release() { :; }
  aify_lifetime_start() { :; }
  aify_lifetime_release() { :; }
fi
# `--aify-start-intent=start|replace` is the lease's, never the runtime's: a Herdr restore passes it.
aify_lease_take_intent "$@"
set -- ${AIFY_LEASE_ARGS[@]+"${AIFY_LEASE_ARGS[@]}"}

# A SHELL INSIDE A RUNNING AGENT SESSION HANDS A START NONE OF THAT SESSION (bin/aify-inherited-session.sh).
# Before anything reads an identity, a mode or a conversation from the environment, and after the line above
# has read whether this command names its agent: a bare launch typed into a pane that inherited another
# agent's session once started as that agent and replaced it, while a named launch a host composed keeps the
# mode and role its host gave it.
AIFY_INHERITED_SESSION_SH="@@WRAPPER_DIR@@/bin/aify-inherited-session.sh"
if [ -r "$AIFY_INHERITED_SESSION_SH" ]; then
  . "$AIFY_INHERITED_SESSION_SH"
  aify_forget_inherited_session "${AIFY_LEASE_NAMED_AGENT:-}"
fi

# ── Herdr: what this invocation was, captured before anything consumes it ───
#
# A Herdr restore replays this array VERBATIM. It has to be what the operator actually typed rather
# than a command rebuilt later from remembered flags, because a rebuilt command drifts from the real
# one the moment either side changes -- and the drift would only show up after a reboot.
AIFY_HERDR_ARGV=("$0" "$@")

# ── Herdr: the host's profile given back, and this pane claimed (bin/aify-herdr-launch.sh) ───
# A wrapper without the helper does neither, as an ordinary terminal launch does not; neither can fail the launch.
AIFY_HERDR_LAUNCH_SH="@@WRAPPER_DIR@@/bin/aify-herdr-launch.sh"
if [ -r "$AIFY_HERDR_LAUNCH_SH" ]; then
  . "$AIFY_HERDR_LAUNCH_SH"
  aify_herdr_restore_profile
  aify_herdr_claim_pane --pane-file
  aify_herdr_leave_to_reporter
fi

# ── The harness wrapper contract ────────────────────────────────────────────
#
# Common host inputs, with Codex's usage and legacy fallbacks:
# docs/contracts/harness-wrapper.md and the fuller commentary in wrappers/claude-aify.sh.in.
#
# RESOLVED AND CHECKED AT THE TOP, ahead of everything, because this wrapper's first act is to
# allocate a port and start a background `codex app-server`. A validation placed after that would have
# already started a process before deciding the configuration was invalid, and `--check` would have to
# start a server in order to report that it starts nothing.
HARNESS_WRAPPER_RUNTIME="codex"
HARNESS_WRAPPER_VERSION="@@WRAPPER_VERSION@@"
#| Baked at install, never read at launch: parsing the registry on every start would spend the
#| MCP discovery budget hermes gives us, and a launcher cannot learn about a service that was
#| registered after it was written anyway. This is how a holder of the CURRENT registry can
#| tell that it could not - by READING the launcher, without starting the runtime.
HARNESS_REGISTRY_FINGERPRINT="@@REGISTRY_FINGERPRINT@@"
#| Exported so the runtime -- and through it the bridge and the service -- can learn which
#| launcher started this session and which registry it was built against. Kept as shell locals
#| these were readable only by opening the file on the host, which is the whole reason a
#| host-side staleness check existed. The export references the assignment above rather than
#| repeating the placeholder: two sources for one fact is how they drift.
export HARNESS_WRAPPER_VERSION="$HARNESS_WRAPPER_VERSION"
export HARNESS_REGISTRY_FINGERPRINT="$HARNESS_REGISTRY_FINGERPRINT"
HARNESS_ENDPOINT="${HARNESS_ENDPOINT-${AIFY_COMMS_URL:-@@ENDPOINT@@}}"
. "$AIFY_WRAPPER_DIR_FWD/bin/aify-input-boundary.sh" || exit 78
aify_json_scalar_safe HARNESS_ENDPOINT "$HARNESS_ENDPOINT" || exit 78
aify_json_scalar_safe AIFY_WRAPPER_DIR_FWD "$AIFY_WRAPPER_DIR_FWD" || exit 78
aify_json_scalar_safe AIFY_BRIDGE_DIR_FWD "$AIFY_BRIDGE_DIR_FWD" || exit 78
HARNESS_IDENTITY="${HARNESS_IDENTITY:-${AIFY_AGENT_ID:-}}"
HARNESS_ROLE="${HARNESS_ROLE:-${AIFY_AGENT_ROLE:-}}"
HARNESS_CWD="${HARNESS_CWD:-${AIFY_AGENT_CWD:-}}"
# Accepted for contract uniformity and REPORTED AS UNUSED by --check, which is the honest state:
# codex's MCP servers are registered at install time with `codex mcp add`, not by this launcher. That
# matches the decision that a host owns whether and when its client config is written; a wrapper that
# silently swallowed this input would be claiming to do a job it does not do.
HARNESS_MCP_COMMAND="${HARNESS_MCP_COMMAND:-}"
HARNESS_EXTRA_ENV="${HARNESS_EXTRA_ENV:-}"
HARNESS_EXIT_CONFIG=78
HARNESS_EXIT_NO_RUNTIME=127

# ── The agent's definition (P0 C9) ──────────────────────────────────────────
# Defaults for role, model and effort, and claude's instructions. What refuses, and why: bin/aify-definition.sh.
AIFY_DEF_FILE=""
AIFY_DEF_ROLE=""
AIFY_DEF_MODEL=""
AIFY_DEF_EFFORT=""
# The defaults among model and effort that hold a control character: the reader names them, because the
# value itself cannot cross this shell intact (bash drops a NUL, and Git Bash a CR).
AIFY_DEF_CONTROL=""
AIFY_IGNORE_DEFINITION=false
for _aify_def_arg in "$@"; do
  if [ "$_aify_def_arg" = "--aify-ignore-definition" ]; then AIFY_IGNORE_DEFINITION=true; fi
done
# THE READER'S SHELL SIDE (bin/aify-definition.sh). Without it nothing can be checked: a named launch refuses as one
# without the reader does, and a managed one says what it lacks and starts.
AIFY_DEFINITION_SH="@@WRAPPER_DIR@@/bin/aify-definition.sh"
if [ -r "$AIFY_DEFINITION_SH" ]; then
  . "$AIFY_DEFINITION_SH"
else
  aify_read_definition() {
    if [ -z "$1" ] || [ "$AIFY_IGNORE_DEFINITION" = true ]; then return 0; fi
    echo "[codex-aify] no definition reader at $AIFY_DEFINITION_SH, so the definition of '$1' cannot be checked; --aify-ignore-definition starts without it." >&2
    if [ "${AIFY_MANAGED_VIA_WRAPPER:-}" = "1" ]; then echo "[codex-aify] this managed launch starts WITHOUT any instructions it holds." >&2; return 0; fi
    exit "$HARNESS_EXIT_CONFIG"
  }
fi

AIFY_LAUNCHER_COMMON_SH="$AIFY_WRAPPER_DIR_FWD/bin/aify-launcher-common.sh"
AIFY_LAUNCHER_COMMON_READY=false
aify_extra_env_apply() { :; }
if [ -r "$AIFY_LAUNCHER_COMMON_SH" ]; then
  . "$AIFY_LAUNCHER_COMMON_SH"
  AIFY_LAUNCHER_COMMON_READY=true
fi
aify_extra_env_apply "$HARNESS_EXTRA_ENV"

# `-` not `:-` above: an explicitly emptied endpoint is a configuration error, not an unset one.
if [ -z "$HARNESS_ENDPOINT" ]; then
  echo "[codex-aify] HARNESS_ENDPOINT is empty. A wrapper will not guess an endpoint." >&2
  exit "$HARNESS_EXIT_CONFIG"
fi

if ! command -v codex >/dev/null 2>&1; then
  echo "[codex-aify] runtime CLI 'codex' was not found on PATH." >&2
  exit "$HARNESS_EXIT_NO_RUNTIME"
fi

pick_port() {
  node -e '
    const net = require("net");
    const server = net.createServer();
    server.listen(0, "127.0.0.1", () => {
      const address = server.address();
      console.log(address && address.port ? String(address.port) : "");
      server.close();
    });
    server.on("error", () => process.exit(1));
  '
}

wait_for_port() {
  local port="$1" app_pid="$2" event waiter_pid result=1
  kill -0 "$app_pid" >/dev/null 2>&1 || return 1
  # The owning Bash job survives MSYS exec; a cached native winpid does not. Check it here,
  # between private events from ONE bounded TCP waiter. Every iteration uses only builtins.
  while IFS= read -r event; do
    kill -0 "$app_pid" >/dev/null 2>&1 || break
    case "$event" in
      poll) ;;
      ready) result=0; break ;;
      *) break ;;
    esac
  done < <(
    node -e '
      const net = require("net");
      const port = Number(process.argv[1]), pid = Number(process.argv[2]);
      if (!Number.isSafeInteger(pid) || pid <= 0) process.exit(1);
      const deadline = Date.now() + 10000;
      setTimeout(() => process.exit(1), 10000);
      process.stdout.on("error", () => process.exit(1));
      function appAlive() {
        if (process.platform === "win32") return true; // The parent checks its MSYS job.
        try { process.kill(pid, 0); return true; } catch { return false; }
      }
      function attempt() {
        if (!appAlive()) process.exit(1);
        process.stdout.write("poll\n");
        const socket = net.createConnection({ host: "127.0.0.1", port });
        socket.on("connect", () => {
          socket.end();
          if (!appAlive()) process.exit(1);
          process.stdout.write("ready\n", () => process.exit(0));
        });
        socket.on("error", () => {
          socket.destroy();
          if (!appAlive() || Date.now() > deadline) process.exit(1);
          setTimeout(attempt, 150);
        });
      }
      attempt();
    ' "$port" "$app_pid"
  )
  waiter_pid=$!
  kill "$waiter_pid" >/dev/null 2>&1 || true
  wait "$waiter_pid" 2>/dev/null || true
  return "$result"
}

CODEX_AUTO=true
CODEX_PERMISSION_SOURCE=default
for ARG in "$@"; do
  case "$ARG" in
    -auto|--auto)
      CODEX_AUTO=true
      CODEX_PERMISSION_SOURCE="$ARG"
      ;;
    --safe|--no-auto|--no-dangerous-permissions)
      CODEX_AUTO=false
      CODEX_PERMISSION_SOURCE="$ARG"
      ;;
  esac
done

CODEX_PERMISSION_FLAGS=()
if [ "$CODEX_AUTO" = true ]; then
  CODEX_PERMISSION_FLAGS+=(--dangerously-bypass-approvals-and-sandbox)
fi

# ── Identity and endpoint, BEFORE the app-server starts ───
#
# THE APP-SERVER RUNS THE AGENT'S HOOKS, AND IT RUNS THEM WITH THE ENVIRONMENT IT STARTED WITH. codex
# builds every hook command with `env_clear()` and replays a snapshot of the owning process's
# environment (codex-rs rust-v0.154.0, hooks/src/engine/command_runner.rs; the snapshot is
# `std::env::vars_os()` in hooks/src/registry.rs). This block used to sit below the app-server launch,
# so a resident `codex-aify --aify-agent x` exported AIFY_AGENT_ID, AIFY_AGENT_ROLE and AIFY_COMMS_URL
# to the TUI only: the app-server, and so every turn and state hook, saw none of them and posted
# nothing. Proven with a stub app-server that recorded its environment. The parse is pure and the
# lookup is one read-only request, so running them before the launch changes what the app-server
# inherits and nothing else.
CODEX_ARGS=()
# --shared: let the HOST TIER own this session's terminal, so closing this window does not end it.
# Recognised here, acted on at the very bottom; every path in between is unchanged, which is the
# operator's constraint on this feature -- an ordinary run must be exactly what it was.
CODEX_AIFY_SHARED=false
# THE ORIGINAL ARGUMENTS, CAPTURED ONCE, minus the flag. Rebuilt inside the parse loop instead, it
# would have to be appended in every one of that loop's branches -- and the branch somebody adds next
# year is the one that silently drops an argument from the relaunch. Filtering `"$@"` here cannot
# drift with the loop, because it does not read it.
CODEX_AIFY_PASSTHRU=()
for _ORIGINAL in "$@"; do
  [ "$_ORIGINAL" = "--shared" ] || CODEX_AIFY_PASSTHRU+=("$_ORIGINAL")
done

CODEX_AIFY_AGENT_ID="$HARNESS_IDENTITY"
# The built-in default is applied after the argument loop, below the agent's definition (P0 C9).
CODEX_AIFY_ROLE="${HARNESS_ROLE:-}"
CODEX_AIFY_SESSION_MODE="${AIFY_SESSION_MODE:-}"
CODEX_RESUME_HANDLE=""
HARNESS_CHECK=false
PREV_ARG=""
for ARG in "$@"; do
  # EXACTLY THIS WORD. `--shared-anything` belongs to whoever reads it; a prefix test here would
  # swallow it and host a session nobody asked to host. Consumed so it never reaches the runtime.
  if [ "$ARG" = "--shared" ]; then
    CODEX_AIFY_SHARED=true
    continue
  fi
  if [ "$PREV_ARG" = "--aify-agent" ] || [ "$PREV_ARG" = "--agent-id" ]; then
    CODEX_AIFY_AGENT_ID="$ARG"
    PREV_ARG=""
    continue
  fi
  if [ "$PREV_ARG" = "--aify-role" ]; then
    CODEX_AIFY_ROLE="$ARG"
    PREV_ARG=""
    continue
  fi
  # Plan 1: pull --resume <handle> out of the arg stream into
  # CODEX_RESUME_HANDLE. The dashboard Console now passes the stored
  # codex session id this way (Task 11). We consume the token rather
  # than forwarding it because codex itself takes the handle as a
  # POSITIONAL argument to its `resume` subcommand (`codex resume <id>`),
  # not as a flag on the top-level `codex --remote` invocation. The
  # positional <id> is what actually resumes the rollout; the
  # --include-non-interactive flag we pass alongside it (below) is a no-op
  # when an explicit id is given and only matters for id-less resume.
  if [ "$PREV_ARG" = "--resume" ] || [ "$PREV_ARG" = "--session-id" ]; then
    CODEX_RESUME_HANDLE="$ARG"
    PREV_ARG=""
    continue
  fi
  if [ "$ARG" = "-auto" ] || [ "$ARG" = "--auto" ]; then
    continue
  fi
  if [ "$ARG" = "--safe" ] || [ "$ARG" = "--no-auto" ] || [ "$ARG" = "--no-dangerous-permissions" ]; then
    continue
  fi
  if [ "$ARG" = "--resident" ]; then
    CODEX_AIFY_SESSION_MODE="resident"
    continue
  fi
  if [ "$ARG" = "--managed" ]; then
    CODEX_AIFY_SESSION_MODE="managed"
    continue
  fi
  if [ "$ARG" = "--aify-ignore-definition" ]; then
    continue
  fi
  if [ "$ARG" = "--check" ]; then
    HARNESS_CHECK=true
    continue
  fi
  if [ "$ARG" = "--aify-agent" ] || [ "$ARG" = "--agent-id" ] || [ "$ARG" = "--aify-role" ]; then
    PREV_ARG="$ARG"
    continue
  fi
  if [ "$ARG" = "--resume" ] || [ "$ARG" = "--session-id" ]; then
    PREV_ARG="$ARG"
    continue
  fi
  case "$ARG" in
  --aify-agent=*|--agent-id=*)
    CODEX_AIFY_AGENT_ID="${ARG#*=}"
    continue
    ;;
  --aify-role=*)
    CODEX_AIFY_ROLE="${ARG#*=}"
    continue
    ;;
  --resume=*|--session-id=*)
    CODEX_RESUME_HANDLE="${ARG#*=}"
    continue
    ;;
  esac
  CODEX_ARGS+=("$ARG")
done
# Missing common functionality refuses only a real launch that needs it, after the existing parser.
if [ "$AIFY_LAUNCHER_COMMON_READY" != true ] && [ "$HARNESS_CHECK" != true ] \
  && { [ -n "$HARNESS_EXTRA_ENV" ] || [ "$CODEX_AIFY_SHARED" = true ]; }; then
  echo "${0##*/}: missing launcher common helper $AIFY_LAUNCHER_COMMON_SH; extra env and --shared cannot be applied." >&2
  exit "$HARNESS_EXIT_CONFIG"
fi
# A model or effort the operator gave codex itself (`-m`, `--model`, `-c model=...`,
# `-c model_reasoning_effort=...`) is theirs: nothing below adds one beside it.
CODEX_HAS_MODEL=false
CODEX_HAS_EFFORT=false
_codex_prev=""
for _codex_arg in "${CODEX_ARGS[@]}"; do
  case "$_codex_prev $_codex_arg" in
    "-c model="*|"--config model="*) CODEX_HAS_MODEL=true ;;
    "-c model_reasoning_effort="*|"--config model_reasoning_effort="*) CODEX_HAS_EFFORT=true ;;
  esac
  case "$_codex_arg" in
    -m|--model|--model=*|--config=model=*) CODEX_HAS_MODEL=true ;;
    --config=model_reasoning_effort=*) CODEX_HAS_EFFORT=true ;;
  esac
  _codex_prev="$_codex_arg"
done
# A MANAGED LAUNCH IS ADDRESSED TO ONE AGENT. The service writes AIFY_MANAGED_* beside AIFY_AGENT_ID for the
# agent it launches, and every process that agent starts inherits them, so a *-aify started from inside its
# session for ANOTHER agent took them as its own and ran the parent's model or effort (external review of
# 0.8.4). A bare launch there takes the session's own id and keeps them; bin/aify-inherited-session.sh is what
# separates that case, when a lease marks the session. They are kept
# only when the id this launcher parsed above (so a repeated --aify-agent resolves as the launch resolves it)
# equals a non-empty inherited AIFY_AGENT_ID. The marker is not part of that test: the service writes
# AIFY_MANAGED_VIA_WRAPPER=0 on a codex or hermes console the operator routes natively, and that launch still
# carries its agent's model. Anything else drops every AIFY_MANAGED_* name, found by prefix with bash's own
# ${!prefix@} (review of b7e60a7), and every line that reads one of them comes after this.
if ! { [ -n "${AIFY_AGENT_ID:-}" ] && [ "$CODEX_AIFY_AGENT_ID" = "$AIFY_AGENT_ID" ]; }; then
  for _aify_managed_name in ${!AIFY_MANAGED_@}; do unset "$_aify_managed_name"; done
fi
if [ "${AIFY_MANAGED_VIA_WRAPPER:-}" = "1" ]; then
  # The app-server owns the managed TUI; its built-in codex_apps MCP tries to
  # initialize through that same not-yet-ready server and deadlocks startup.
  # Below the guard, so a codex-aify started inside a managed agent does not take its parent's marker.
  CODEX_PERMISSION_FLAGS+=(--disable apps)
fi
# Role, model and effort for the id known now: a flag, then the environment (HARNESS_ROLE or
# AIFY_AGENT_ROLE; a managed launch's AIFY_MANAGED_MODEL / AIFY_MANAGED_EFFORT), then the definition,
# then the built-in default (codex's own, for model and effort). --check and the launch both resolve it
# here, so the check reports what the launch would use (review of P6, R4); the launch runs it again below
# for an id a resume handle names.
CODEX_AIFY_ROLE_GIVEN="$CODEX_AIFY_ROLE"
codex_aify_defaults() {
  aify_read_definition "$CODEX_AIFY_AGENT_ID" codex
  CODEX_AIFY_ROLE="${CODEX_AIFY_ROLE_GIVEN:-${AIFY_DEF_ROLE:-coder}}"
  CODEX_AIFY_MODEL=""
  CODEX_AIFY_EFFORT=""
  if [ "$CODEX_HAS_MODEL" = false ]; then CODEX_AIFY_MODEL="${AIFY_MANAGED_MODEL:-$AIFY_DEF_MODEL}"; fi
  if [ "$CODEX_HAS_EFFORT" = false ]; then CODEX_AIFY_EFFORT="${AIFY_MANAGED_EFFORT:-$AIFY_DEF_EFFORT}"; fi
  # codex takes both as TOML strings, and a control character such as a newline has no place in a model
  # or an effort: written raw it made the app-server's configuration invalid (review of P6r, L2). A
  # DEFINITION's value is checked by name, as the reader reports it, because the value itself arrives
  # with a NUL or CR already gone (review of P6r2, L2); only the one this launch selects counts.
  local _codex_def_picked=""
  if [ "$CODEX_HAS_MODEL" = false ] && [ -z "${AIFY_MANAGED_MODEL:-}" ]; then _codex_def_picked="model"; fi
  if [ "$CODEX_HAS_EFFORT" = false ] && [ -z "${AIFY_MANAGED_EFFORT:-}" ]; then _codex_def_picked="$_codex_def_picked effort"; fi
  local _codex_field _codex_control=false
  for _codex_field in $_codex_def_picked; do
    case " $AIFY_DEF_CONTROL " in *" $_codex_field "*) _codex_control=true ;; esac
  done
  case "$CODEX_AIFY_MODEL$CODEX_AIFY_EFFORT" in *[[:cntrl:]]*) _codex_control=true ;; esac
  case "$_codex_control" in
    true)
      echo "codex-aify: the model or effort for '${CODEX_AIFY_AGENT_ID:-<no agent>}' holds a control character, which codex's configuration cannot take; refusing to start." >&2
      exit 78 ;;
  esac
}

AIFY_CODEX_AUTH_MODULE="$AIFY_WRAPPER_DIR_FWD/lib/codex-app-server-auth.mjs"

# --check answers "is this configured and can it find its runtime" WITHOUT starting anything. It
# reports what the argument loop resolved and exits before the service lookup and the app-server
# launch, neither of which it may do; an id only a resume handle would name is therefore not shown.
if [ "$HARNESS_CHECK" = true ]; then
  [ "$AIFY_LAUNCHER_COMMON_READY" = true ] || echo "  missing helper: $AIFY_LAUNCHER_COMMON_SH"
  codex_aify_defaults
  echo "codex-aify $HARNESS_WRAPPER_VERSION"
  echo "  runtime   : $HARNESS_WRAPPER_RUNTIME ($(command -v codex))"
  if [ "$CODEX_AUTO" = true ]; then
    _codex_permission_mode=bypass
  else
    _codex_permission_mode=omitted
  fi
  echo "  wrapper-selected permissions: mode=$_codex_permission_mode; source=$CODEX_PERMISSION_SOURCE; not final runtime permissions"
  echo "  app-server auth: capability-token required; runtime support not probed by --check"
  [ -r "$AIFY_CODEX_AUTH_MODULE" ] || echo "  missing helper: $AIFY_CODEX_AUTH_MODULE"
  echo "  endpoint  : $HARNESS_ENDPOINT"
  echo "  identity  : ${CODEX_AIFY_AGENT_ID:-<none — this session would be anonymous>}"
  echo "  role      : $CODEX_AIFY_ROLE"
  echo "  definition: ${AIFY_DEF_FILE:-<none>}"
  _aify_managed_kept="${!AIFY_MANAGED_@}"
  echo "  managed   : ${_aify_managed_kept:-<not a managed launch>}"
  if [ "$CODEX_HAS_MODEL" = true ]; then echo "  model     : <given as an argument>"; else echo "  model     : ${CODEX_AIFY_MODEL:-<the runtime default>}"; fi
  if [ "$CODEX_HAS_EFFORT" = true ]; then echo "  effort    : <given as an argument>"; else echo "  effort    : ${CODEX_AIFY_EFFORT:-<the runtime default>}"; fi
  echo "  cwd       : ${HARNESS_CWD:-<inherited>}"
  echo "  mcp       : HARNESS_MCP_COMMAND not used by this wrapper (codex mcp add runs at install time)"
  if [ -n "@@SESSION_MCP_CODEX_B64@@" ]; then echo "  session   : the registry's opted-in servers, baked in at install"; else echo "  session   : <none opted in at install>"; fi
  echo "  registry  : $HARNESS_REGISTRY_FINGERPRINT"
  echo "OK — nothing was started."
  exit 0
fi
export AIFY_RUNTIME="codex"
# IDENTITY RECOVERY (2026-07-28) — the third wrapper finally gets what the other two have.
#
# Every turn-state path is gated on AIFY_AGENT_ID. With no id, this session cannot report
# turn-start/turn-end, so the agent's status LATCHES: nothing alive can ever clear it, and it looks
# healthy from every other angle. claude-aify's comment records what that costs ("days of
# general-manager is always working").
#
# claude-aify has recovered the agent from a bare `--resume <id>` since 2026-07-14, and hermes-aify
# since 2026-06-03. hermes-aify's own comment admitted the gap verbatim: "codex still has no such
# recovery: its operator path is covered by the resume command now carrying --aify-agent, but a
# hand-typed `codex-aify --resume <id>` is still identity-less." The dashboard's Resume passes
# --aify-agent, so only the HAND-TYPED path was broken — which is exactly the path an operator uses.
#
# Ask the SERVICE which agent owns this thread handle: authoritative, and it survives a reboot.
# Scoped to runtime="codex" so a claude and a codex agent that happen to share a handle string can
# never cross-bind (the cross-contamination class already fixed for claude). Unlike claude there is
# no local session store to fall back to — `claude-session-store.js` is claude-specific — so if the
# service is unreachable the id stays empty and we say so out loud rather than degrade in silence.
if [ -z "$CODEX_AIFY_AGENT_ID" ] && [ -n "${CODEX_RESUME_HANDLE:-}" ]; then
  if command -v node >/dev/null 2>&1; then
    # `|| _aify_codex_rec=""` is load-bearing. Under `set -euo pipefail` this assignment inherits the
    # command's status, so an unreachable service ended the wrapper here: no codex, no message, just
    # the lookup's exit code. Identity recovery is best-effort by design — the store lookup below and the
    # explicit warning already cover the failure — so it must never be able to stop a launch.
    # The bridge does the lookup: it knows where this host's API key is, and a launcher does not.
    # A bare curl here got a 401 as soon as the service required a key (aify-comms D36).
    _aify_codex_rec="$(node "$AIFY_BRIDGE_DIR_FWD/agent-for-handle.mjs" "$HARNESS_ENDPOINT" codex "$CODEX_RESUME_HANDLE" 2>/dev/null)" || _aify_codex_rec=""
    if [ -n "$_aify_codex_rec" ]; then
      CODEX_AIFY_AGENT_ID="$_aify_codex_rec"
      echo "[codex-aify] resolved aify agent '$CODEX_AIFY_AGENT_ID' from thread handle '$CODEX_RESUME_HANDLE' (service lookup)." >&2
    fi
  fi
fi
if [ -z "$CODEX_AIFY_AGENT_ID" ] && [ -n "${CODEX_RESUME_HANDLE:-}" ]; then
  echo "[codex-aify] NO AGENT ID for --resume $CODEX_RESUME_HANDLE: aify turn/status detection is DISABLED for this session (status will latch). Pass --aify-agent <id> if this is a registered agent." >&2
fi
# Read for the resolved id, a recovered one included, before anything is exported or started (P6 R3).
codex_aify_defaults
if [ -n "$CODEX_AIFY_AGENT_ID" ]; then
  export AIFY_AGENT_ID="$CODEX_AIFY_AGENT_ID"
  export AIFY_AGENT_ROLE="$CODEX_AIFY_ROLE"
fi
# Expose the aify service URL so codex's UserPromptSubmit / Stop hooks
# (installed by install.sh's install_codex_turn_hooks) can POST the
# turn-start / turn-end signals to the bridge symmetrically with
# claude-aify. Without this, the hooks would no-op because they gate
# on ${AIFY_COMMS_URL:-}.
export AIFY_COMMS_URL="$HARNESS_ENDPOINT"

# These reach the aify-comms MCP bridge as well as the hooks: codex starts MCP servers from the
# APP-SERVER, not the TUI (observed 2026-09-15, `.aify-comms/mcp/stdio/server.js` a child of
# `codex app-server`), so an export made after the launch below is one the bridge never sees.
# Session-mode resolution: explicit flag/env > TTY auto-detect. See
# claude-aify for the rationale; same contract applies here.
# INFERRED, NOT CHOSEN -- and that distinction has to survive a `--shared` relaunch (R9-M10,
# external review 2026-09-06). This resolves from THIS process's stdin, and the `--shared` block
# below hands the session to aify-env, which forwards the whole environment to a host that runs the
# launcher IN A PTY. So a non-TTY caller -- a script, a CI job, a non-interactive shell -- inferred
# `managed` here and pinned it onto a relaunch where `[ -t 0 ]` would have said `resident`. The
# service then treats a session with a real PTY as a backing process with no operator at it.
#
# An EXPLICIT choice (--resident, --managed, or AIFY_SESSION_MODE in the environment) must still
# travel, which is why this marks the inference rather than dropping the value outright.
AIFY_SESSION_MODE_INFERRED=0
if [ -z "$CODEX_AIFY_SESSION_MODE" ]; then
  if [ -t 0 ]; then
    CODEX_AIFY_SESSION_MODE="resident"
  else
    CODEX_AIFY_SESSION_MODE="managed"
  fi
  AIFY_SESSION_MODE_INFERRED=1
fi
export AIFY_SESSION_MODE="$CODEX_AIFY_SESSION_MODE"

# Fresh codex-aify launch must not infer a current thread from historical
# ~/.codex/sessions files. That scan can only find an old rollout, not the
# thread this just-started --remote TUI is attached to. Explicit --resume
# remains authoritative and is exported below so the bridge and Codex agree.
if [ -z "${CODEX_RESUME_HANDLE:-}" ]; then
  : # Fresh codex-aify launch: leave CODEX_THREAD_ID/AIFY_SESSION_HANDLE unset.
else
  # Explicit --resume <id> from operator wins. Make the bridge see the
  # same handle codex will resume so they don't disagree for the first
  # 60s after launch.
  export CODEX_THREAD_ID="$CODEX_RESUME_HANDLE"
  export AIFY_SESSION_HANDLE="$CODEX_RESUME_HANDLE"
fi

# Definition resolution keeps its existing refusal precedence; auth still refuses before runtime startup.
if [ ! -r "$AIFY_CODEX_AUTH_MODULE" ]; then
  echo "codex-aify: missing auth helper $AIFY_CODEX_AUTH_MODULE; refusing an unauthenticated app-server." >&2
  exit "$HARNESS_EXIT_CONFIG"
fi
# One launch, one capability. Its verifier is public argv; raw material travels only in inherited env.
# Descendants (including agent tools) may inherit it: TOKEN filtering is not a security assumption.
_aify_auth_trace=0
case "$-" in *x*) set +x; _aify_auth_trace=1 ;; esac
unset AIFY_CODEX_APP_SERVER_TOKEN AIFY_CODEX_APP_SERVER_TOKEN_SHA256 AIFY_CODEX_REMOTE_AUTH_TOKEN_ENV
_aify_auth_status=0
_aify_auth_material="$(node --input-type=module -e '
  import { randomBytes } from "node:crypto";
  import { pathToFileURL } from "node:url";
  const { codexAuthMaterial } = await import(pathToFileURL(process.argv[1]).href);
  const material = codexAuthMaterial(randomBytes(32));
  process.stdout.write(material.token + "\t" + material.sha256);
' "$AIFY_CODEX_AUTH_MODULE")" || _aify_auth_status=$?
# Parameter expansion performs no I/O; older Bash can put a here-string's raw material in a temp file.
AIFY_CODEX_APP_SERVER_TOKEN="${_aify_auth_material%%$'\t'*}"
AIFY_CODEX_APP_SERVER_TOKEN_SHA256="${_aify_auth_material#*$'\t'}"
if [ "$_aify_auth_status" -ne 0 ] \
  || [[ ! "$AIFY_CODEX_APP_SERVER_TOKEN" =~ ^[A-Za-z0-9_-]{43}$ ]] \
  || [[ ! "$AIFY_CODEX_APP_SERVER_TOKEN_SHA256" =~ ^[0-9a-f]{64}$ ]]; then
  echo "codex-aify: could not create app-server authentication; refusing to start." >&2
  exit "$HARNESS_EXIT_CONFIG"
fi
export AIFY_CODEX_APP_SERVER_TOKEN
export AIFY_CODEX_REMOTE_AUTH_TOKEN_ENV=AIFY_CODEX_APP_SERVER_TOKEN
unset _aify_auth_material _aify_auth_status
if [ "$_aify_auth_trace" = 1 ]; then unset _aify_auth_trace; set -x; else unset _aify_auth_trace; fi
CODEX_APP_SERVER_AUTH=(--ws-auth capability-token --ws-token-sha256 "$AIFY_CODEX_APP_SERVER_TOKEN_SHA256")

# The app-server's port and log, below the check block.
PORT="$(pick_port)"
if [ -z "$PORT" ]; then
  echo "Failed to allocate a local port for codex app-server." >&2
  exit 1
fi

APP_SERVER_URL="ws://127.0.0.1:$PORT"
export AIFY_CODEX_APP_SERVER_URL="$APP_SERVER_URL"

LOG_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/@@SERVICE_NAME@@"
mkdir -p "$LOG_ROOT"
LOG_FILE="$LOG_ROOT/codex-aify-app-server-$PORT.log"

# ── Herdr: the pane's status dot follows the agent ───
#
# A claimed pane shows the state its claim last reported, not what Herdr sees on screen, so the
# claim's `idle` stood for the life of the pane. When this pane is claimed, or aify-env will name the
# pane showing this managed worker (AIFY_HERDR_PANE_FILE), the app-server gets codex hooks that report
# working / blocked / idle through aify-herdr-state.sh. They go on the APP-SERVER's command line
# because that process runs the agent and its hooks; nothing is written to ~/.codex.
#
# CODEX ASKS BEFORE RUNNING A HOOK IT HAS NOT SEEN, and lib/codex-herdr-hooks.mjs records exactly how.
# A resident launch shows the review once and the operator decides. A managed RESUME would show it to
# nobody and never start, so the helper withholds the hooks there until config.toml trusts them.
# Claimed before the app-server starts, so a refused start leaves nothing running. A `--shared` launch
# hands the session to the host, whose run of this launcher is the one that claims.
if [ "$CODEX_AIFY_SHARED" != true ]; then
  AIFY_LEASE_AGENT="" # An inherited marker is not this attempt's claim, even with a missing shell helper.
  aify_lease_claim "${CODEX_AIFY_AGENT_ID:-}" codex "${AIFY_SESSION_MODE:-}" || exit $?
fi
CODEX_HERDR_HOOKS=()
if aify_herdr_hooks_report 2>/dev/null; then
  export AIFY_HERDR_AGENT="${0##*/}"
  _aify_herdr_trust=()
  if [ "${AIFY_MANAGED_VIA_WRAPPER:-}" = "1" ]; then
    for _aify_arg in "$@"; do
      case "$_aify_arg" in
        --resume|--resume=*|--session-id|--session-id=*) _aify_herdr_trust=(--require-trust "${CODEX_HOME:-$HOME/.codex}/config.toml") ;;
      esac
    done
  fi
  while IFS= read -r _aify_line; do
    CODEX_HERDR_HOOKS+=("$_aify_line")
  done < <(node "$AIFY_HERDR_HELPER" codex-hooks --state-script "$AIFY_WRAPPER_DIR_FWD/bin/aify-herdr-state.sh" "${_aify_herdr_trust[@]}" 2>>"$AIFY_HERDR_LOG" || true)
fi

# ── The app-server's configuration ───
#
# ONE array, built here and expanded on both app-server lines, never on the TUI's: the app-server runs
# the agent, and the TUI takes its configuration from the app-server (`config/read`) and starts its
# thread with that model. Observed on codex-cli 0.159.3 through a logging proxy: `-c model=...` and
# `-c model_reasoning_effort=...` here decide the thread's model and effort over CODEX_HOME's
# config.toml, and a `-m` given to the TUI still beats them (aify-comms
# docs/superpowers/plans/evidence/2026-10-01-p6/codex-model-probe.mjs). Other blocks add their own
# labelled pairs below this one rather than a second array.
# A TOML basic string. The pattern and replacement are quoted so every bash reads them literally.
codex_toml_string() {
  local _v="$1" _bs='\' _dq='"'
  _v="${_v//"$_bs"/"$_bs$_bs"}"
  _v="${_v//"$_dq"/"$_bs$_dq"}"
  printf '"%s"' "$_v"
}
CODEX_APP_SERVER_CONFIG=()
# The agent's model and effort: a managed launch's, else its definition's (codex_aify_defaults).
if [ -n "$CODEX_AIFY_MODEL" ]; then CODEX_APP_SERVER_CONFIG+=(-c "model=$(codex_toml_string "$CODEX_AIFY_MODEL")"); fi
if [ -n "$CODEX_AIFY_EFFORT" ]; then CODEX_APP_SERVER_CONFIG+=(-c "model_reasoning_effort=$(codex_toml_string "$CODEX_AIFY_EFFORT")"); fi
# The services opted into every session ("sessionInject": {"mcp": true}), as `-c mcp_servers.<name>.*` words
# that `registry-cli.mjs session-codex-b64` built at install. Empty unless a service asked, and then nothing is
# added. NUL-terminated, then base64: a word holding a space, a quote or a newline arrives as ONE word, which no
# separator a word can contain would guarantee. A word cannot hold a NUL, because the TOML strings escape it.
#
# Decoded to a file and checked, rather than read from `< <(... | base64 -d)`: a process substitution's failure
# is invisible, so a damaged value would start the agent quietly WITHOUT its servers.
if [ -n "@@SESSION_MCP_CODEX_B64@@" ]; then
  _session_words="$(mktemp)"
  if ! printf '%s' "@@SESSION_MCP_CODEX_B64@@" | base64 -d >"$_session_words" 2>/dev/null; then
    rm -f "$_session_words"
    echo "codex-aify: this launcher's session MCP servers do not decode. Re-run the installer." >&2
    exit 78
  fi
  while IFS= read -r -d '' _word; do CODEX_APP_SERVER_CONFIG+=("$_word"); done <"$_session_words"
  rm -f "$_session_words"
fi

if [ "$CODEX_AIFY_SHARED" != true ]; then
  aify_lifetime_start "${CODEX_AIFY_AGENT_ID:-}" codex "$AIFY_SESSION_MODE" || exit $?
  trap 'aify_lifetime_release; aify_lease_release' EXIT
fi
# Only this attempt's named holder rotates its own log pair. Any failure keeps the per-port log and still starts.
if [ "$CODEX_AIFY_SHARED" != true ] && [ -n "${CODEX_AIFY_AGENT_ID:-}" ] && [ "${AIFY_LEASE_AGENT:-}" = "$CODEX_AIFY_AGENT_ID" ]; then
  _aify_named_log="$(node --input-type=module -e '
    import fs from "node:fs";
    import path from "node:path";
    import { pathToFileURL } from "node:url";
    const { sessionFolder, writeSessionFile } = await import(pathToFileURL(process.argv[1]).href);
    const folder = await sessionFolder({ agentId: process.argv[2] });
    if (!folder.ok) process.exit(1);
    const file = path.join(folder.dir, "codex-app-server.log");
    if (fs.existsSync(file)) fs.renameSync(file, file + ".1");
    process.stdout.write(await writeSessionFile(folder.dir, "codex-app-server.log", ""));
  ' "$AIFY_WRAPPER_DIR_FWD/lib/session-folder.mjs" "$CODEX_AIFY_AGENT_ID" 2>/dev/null)" || _aify_named_log=""
  if [ -n "$_aify_named_log" ]; then
    LOG_FILE="$_aify_named_log"
  else
    echo "codex-aify: named app-server log unavailable; using per-port log." >&2
  fi
  unset _aify_named_log
fi

if command -v setsid >/dev/null 2>&1; then
  setsid codex "${CODEX_PERMISSION_FLAGS[@]}" "${CODEX_HERDR_HOOKS[@]}" "${CODEX_APP_SERVER_CONFIG[@]}" app-server --listen "$APP_SERVER_URL" "${CODEX_APP_SERVER_AUTH[@]}" </dev/null >>"$LOG_FILE" 2>&1 &
else
  codex "${CODEX_PERMISSION_FLAGS[@]}" "${CODEX_HERDR_HOOKS[@]}" "${CODEX_APP_SERVER_CONFIG[@]}" app-server --listen "$APP_SERVER_URL" "${CODEX_APP_SERVER_AUTH[@]}" </dev/null >>"$LOG_FILE" 2>&1 &
fi
APP_SERVER_PID=$!
RUNTIME_PID=""
# Attached because a tree or group kill of this launcher may not reach it: `setsid` puts it outside the
# group where setsid exists, and on Windows it runs as a native process behind a node shim.
aify_lease_attach "$APP_SERVER_PID" app-server

# The runtime marker is written by the long-lived aify-comms MCP bridge
# itself (mcp/stdio/server.js) on startup when it sees
# AIFY_CODEX_APP_SERVER_URL in its environment.

# THE TUI'S EXIT IS REPORTED, HOWEVER IT EXITS: a turn-end, and idle to a pane the hooks report to.
# No hook fires when codex itself goes away, so the agent read `working` until something else cleared
# it. See claude-aify for the full reasoning. It runs from `cleanup`, after the app-server is gone so
# no later hook can undo it. `cleanup` is trapped on four signals and runs again on EXIT, and the
# `--shared` block calls it before its exec; AIFY_RUNTIME_RUNNING is set only while the TUI runs and
# cleared on the first report, so none of those report twice or report a TUI that never started.
AIFY_RUNTIME_RUNNING=0
_aify_runtime_exited() {
  [ "$AIFY_RUNTIME_RUNNING" = 1 ] || return 0
  AIFY_RUNTIME_RUNNING=0
  _aify_exit_herdr=""
  if aify_herdr_hooks_report 2>/dev/null; then _aify_exit_herdr=herdr; fi
  sh "@@WRAPPER_DIR@@/bin/aify-runtime-exited.sh" "@@BRIDGE_DIR@@" "$_aify_exit_herdr" </dev/null >/dev/null 2>&1 || true
}

cleanup() {
  if [ -n "${RUNTIME_PID:-}" ] && kill -0 "$RUNTIME_PID" >/dev/null 2>&1; then
    kill "$RUNTIME_PID" >/dev/null 2>&1 || true
    wait "$RUNTIME_PID" 2>/dev/null || true
  fi
  if kill -0 "$APP_SERVER_PID" >/dev/null 2>&1; then
    kill "$APP_SERVER_PID" >/dev/null 2>&1 || true
    wait "$APP_SERVER_PID" 2>/dev/null || true
  fi
  _aify_runtime_exited
  aify_lifetime_release
  aify_lease_release
}
trap cleanup EXIT INT TERM HUP

run_codex_foreground() {
  set +e
  AIFY_RUNTIME_RUNNING=1
  # Keep Codex in the foreground. In a non-interactive bash wrapper, async
  # commands (`codex ... &`) receive /dev/null on stdin, so the Codex TUI exits
  # with "stdin is not a terminal" even when the operator launched from a TTY.
  codex "$@"
  local status=$?
  set -e
  RUNTIME_PID=""
  return "$status"
}

if ! wait_for_port "$PORT" "$APP_SERVER_PID"; then
  # Match a real argument-rejection line, never a generic error that merely mentions an auth flag.
  for _aify_auth_flag in "${CODEX_APP_SERVER_AUTH[@]}"; do
    case "$_aify_auth_flag" in --*)
      if tail -n 8 "$LOG_FILE" 2>/dev/null | grep -Fxq -- "error: unexpected argument '$_aify_auth_flag' found"; then
        echo "codex-aify: this Codex does not support app-server auth (qualified codex-cli 0.166.0); rejected $_aify_auth_flag." >&2
        exit "$HARNESS_EXIT_CONFIG"
      fi ;;
    esac
  done
  echo "codex-aify could not reach the local app-server at $APP_SERVER_URL." >&2
  echo "Check $LOG_FILE for details." >&2
  exit 1
fi

# Plan 6 follow-up (2026-05-26): dashboard-spawned managed codex wrappers
# must boot without operator approval gates. The TUI's hooks-trust gate
# blocks startup until "Trust all hooks and continue" is selected manually,
# which leaves the wrapper PTY visible+attached but never loads the inner
# aify-comms MCP server — every dispatch sits queued forever (observed
# 2026-05-26 with graph-senior-dev). Bypass hook-trust on managed wrappers
# only. Operator-launched resident codex-aify keeps its normal trust UX.
if [ "${AIFY_MANAGED_VIA_WRAPPER:-}" = "1" ]; then
  CODEX_PERMISSION_FLAGS+=(--dangerously-bypass-hook-trust)
fi

# Plan 1: try-resume, fall back to fresh codex if the saved session
# file has been GC'd by codex itself (os error 2). The wrapper does not
# abort on a stale handle — the operator gets a fresh codex shell and
# the bridge heartbeat will report the new session id within 60s.
#
# Plan 4 (2026-05-25) — codex's session storage layout varies:
#   - flat: ~/.codex/sessions/<id>.jsonl
#   - date-sharded: ~/.codex/sessions/YYYY/MM/DD/rollout-<iso-ts>-<id>.jsonl
#   - dir-per-session: ~/.codex/sessions/<id>/...
# Accept any of these layouts when probing for a saved session.
# Under `$CODEX_HOME` when it is set, as codex itself stores them: reading `~/.codex` regardless
# reported a session that exists as "not found" and started a fresh codex instead.
CODEX_SESSIONS_DIR="${CODEX_HOME:-$HOME/.codex}/sessions"
CODEX_SESSION_FOUND=""
if [ -n "${CODEX_RESUME_HANDLE:-}" ]; then
  # Try flat layout first (cheapest check)
  if [ -f "$CODEX_SESSIONS_DIR/$CODEX_RESUME_HANDLE.jsonl" ]; then
    CODEX_SESSION_FOUND="$CODEX_SESSIONS_DIR/$CODEX_RESUME_HANDLE.jsonl"
  # Try dir-per-session
  elif [ -d "$CODEX_SESSIONS_DIR/$CODEX_RESUME_HANDLE" ]; then
    CODEX_SESSION_FOUND="$CODEX_SESSIONS_DIR/$CODEX_RESUME_HANDLE"
  # Try date-sharded — search recursively for files containing the handle. A find that fails is a session
  # not found: under `set -euo pipefail` its status ended the launch silently, exit 1, on a CODEX_HOME with
  # no sessions folder yet, and `head` closing the pipe early can fail it the same way.
  else
    CODEX_SESSION_FOUND="$( { find "$CODEX_SESSIONS_DIR" -type f -name "*$CODEX_RESUME_HANDLE*" 2>/dev/null || true; } | head -1)"
  fi
fi

# `--shared` OUTRANKS A LOCAL RESUME, and this guard is R9-H4 (external review, 2026-09-06).
#
# This is R8-H6's defect in the wrapper beside it: hermes learned it at line 573 and codex did not.
# `codex-aify --shared --resume <id>` found the saved session, ran it in THIS terminal and
# `exit $?`d -- eighteen lines above the `--shared` block, which therefore never executed. aify-env
# was never called and nothing was written to stderr, so the operator got a working codex that was
# simply not shared, with no indication that the flag had been ignored. Proven with a stub.
#
# The handle is NOT dropped: it is already in CODEX_AIFY_PASSTHRU, so the host resumes the same
# session on the far side. What changes is WHERE it resumes.
if [ -n "${CODEX_RESUME_HANDLE:-}" ] && [ "$CODEX_AIFY_SHARED" != true ]; then
  if [ -n "$CODEX_SESSION_FOUND" ]; then
    run_codex_foreground --remote "$APP_SERVER_URL" --remote-auth-token-env AIFY_CODEX_APP_SERVER_TOKEN "${CODEX_PERMISSION_FLAGS[@]}" "${CODEX_ARGS[@]}" resume --include-non-interactive "$CODEX_RESUME_HANDLE"
    exit $?
  else
    echo "[codex-aify] saved session $CODEX_RESUME_HANDLE not found in codex storage; starting fresh codex" >&2
  fi
fi
# --shared: HAND THE SESSION TO THE HOST TIER instead of running it as a child of this shell.
#
# It asks aify-env to run THIS WRAPPER again, without the flag, and attaches to it. So what runs is
# exactly what the launch below would have run -- every resolution and every flag composed above --
# rather than a command rebuilt from the parts somebody remembered. It passes the host's launcher
# allowlist by being a wrapper, which is what that allowlist is for.
#
# The process then belongs to aify-env: closing this window leaves it running, Ctrl-] detaches, and
# anyone can attach again. That is the whole point.
#
# BELOW EVERYTHING, so an ordinary run reaches the launch having executed not one instruction of
# this. The operator's constraint on the feature is that the default path is unchanged.
if [ "$CODEX_AIFY_SHARED" = true ]; then
  aify_shared_require_host || exit $?
  # Keep Codex's order: drop inferred mode, stop its already-started children, then clear traps before exec.
  aify_shared_drop_inferred_mode
  cleanup
  trap - EXIT INT TERM HUP
  # Only handoff outlives this shell: never give the host the superseded capability or verifier.
  unset AIFY_CODEX_APP_SERVER_TOKEN AIFY_CODEX_REMOTE_AUTH_TOKEN_ENV AIFY_CODEX_APP_SERVER_TOKEN_SHA256 _aify_auth_material
  aify_shared_handoff "@@SERVICE_NAME@@" "$0" "${CODEX_AIFY_AGENT_ID:-}" "${CODEX_AIFY_PASSTHRU[@]}"
fi

run_codex_foreground --remote "$APP_SERVER_URL" --remote-auth-token-env AIFY_CODEX_APP_SERVER_TOKEN "${CODEX_PERMISSION_FLAGS[@]}" "${CODEX_ARGS[@]}"
exit $?
